{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "format": "npx prettier . --write",
    "postinstall": "nuxt prepare",
    "generate-schema": "dotenv -c -- bash -c 'gql.tada generate schema https://graphql.datocms.com --header \"X-Exclude-Invalid: true\" --header \"Authorization: $NUXT_PUBLIC_DATOCMS_PUBLISHED_CONTENT_CDA_TOKEN\" && gql.tada generate-output'",
    "generate-cma-types": "dotenv -c -- bash -c 'DATOCMS_API_TOKEN=$NUXT_DATOCMS_CMA_TOKEN npx datocms schema:generate lib/datocms/cma-types.ts'",
    "prepare": "npx simple-git-hooks && npm run generate-schema && npm run generate-cma-types",
    "lint": "prettier --check ."
  },
  "dependencies": {
    "@datocms/cda-client": "^0.3.2",
    "@datocms/cma-client": "^6.8.0",
    "@mux/mux-player": "^3.14.0",
    "datocms-structured-text-to-plain-text": "^6.0.0",
    "gql.tada": "^1.11.4",
    "highlight.js": "^11.12.0",
    "jsonwebtoken": "^9.0.3",
    "jwt-decode": "^4.0.0",
    "node-html-parser": "^9.0.4",
    "nuxt": "^4.6.1",
    "vue": "latest",
    "vue-datocms": "^8.1.19"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "datocms": "^4.2.0",
    "dotenv-cli": "^11.0.0",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run format"
  },
  "overrides": {
    "archiver-utils": {
      "glob": "^13.0.6"
    },
    "tty-table": {
      "csv": "^6.6.4"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "simple-git-hooks@2.14.0": true,
    "yarn@1.22.22": true
  }
}
